{
  "redirects": [
    {
      "source": "/soportes",
      "destination": "/soportes-publicitarios",
      "permanent": true
    },
    {
      "source": "/soportes/led",
      "destination": "/soportes-publicitarios/pantallas-led",
      "permanent": true
    },
    {
      "source": "/soportes/tradicional",
      "destination": "/soportes-publicitarios/tradicional",
      "permanent": true
    },
    {
      "source": "/soportes/led-movil",
      "destination": "/soportes-publicitarios/led-movil",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/explorer",
      "destination": "/index.html"
    },
    {
      "source": "/explorer/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/inventory",
      "destination": "/inventory.json"
    }
  ]
}