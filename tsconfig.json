{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
    },

    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "server.ts", "vite.config.ts", "tailwind.config.ts", "src/types/**/*.d.ts"]
}