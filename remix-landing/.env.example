# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- SECURITY & AUTHENTICATION CONFIGURATIONS ---

# JWT_SECRET: Private key used to sign and verify administration session tokens.
# Must be a cryptographically strong string (minimum 32 characters in production).
JWT_SECRET=""

# CORS_ORIGIN: Whitelisted origin URL for administrative API requests in production.
# Match this to your domain/hosting URL to prevent Cross-Origin Resource Sharing abuses.
CORS_ORIGIN="https://grupocomunicarte.com"

# --- INITIAL ADMINISTRATOR BOOTSTRAP CONFIGURATIONS ---

# INITIAL_SUPERADMIN_EMAIL: Initial email for the highest-privilege administrator.
INITIAL_SUPERADMIN_EMAIL=""

# INITIAL_SUPERADMIN_PASSWORD: Initial password for SúperAdmin. MUST be at least 12 characters.
INITIAL_SUPERADMIN_PASSWORD="!"

# INITIAL_ADMIN_EMAIL: Initial email for the operator/commercial admin.
INITIAL_ADMIN_EMAIL=""

# INITIAL_ADMIN_PASSWORD: Initial password for Admin. MUST be at least 12 characters.
INITIAL_ADMIN_PASSWORD=""

# --- SERVICE PORT ---
PORT=3000
